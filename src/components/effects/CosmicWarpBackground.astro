---
---

<div class="cosmic-warp-container" aria-hidden="true">
  <canvas id="cosmic-canvas" class="cosmic-canvas"></canvas>

  <!-- 3D Floating Cyber Geometric Gyroscope Visual in Background -->
  <div class="floating-cyber-poly">
    <div class="poly-ring ring-1"></div>
    <div class="poly-ring ring-2"></div>
    <div class="poly-ring ring-3"></div>
    <div class="poly-core"></div>
  </div>
</div>

<style>
  .cosmic-warp-container {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    transform: translateZ(0);
  }

  .cosmic-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.85;
    transform: translateZ(0);
  }

  /* 3D Floating Gyroscope Visual in Top-Right Background */
  .floating-cyber-poly {
    position: absolute;
    top: 12%;
    right: 5%;
    width: 300px;
    height: 300px;
    transform-style: preserve-3d;
    perspective: 800px;
    opacity: 0.32;
    animation: floatSmooth 8s ease-in-out infinite alternate;
    will-change: transform;
    transform: translateZ(0);
  }

  .poly-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid transparent;
    will-change: transform;
  }

  .ring-1 {
    border-color: rgba(0, 247, 255, 0.4);
    border-top-color: #00f7ff;
    box-shadow: 0 0 20px rgba(0, 247, 255, 0.25);
    transform: rotateX(65deg) rotateY(25deg);
    animation: ringSpin1 16s linear infinite;
  }

  .ring-2 {
    border-color: rgba(255, 0, 127, 0.4);
    border-bottom-color: #ff007f;
    box-shadow: 0 0 20px rgba(255, 0, 127, 0.25);
    transform: rotateX(25deg) rotateY(70deg);
    animation: ringSpin2 22s linear infinite reverse;
  }

  .ring-3 {
    border-color: rgba(168, 85, 247, 0.4);
    border-left-color: #a855f7;
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.25);
    transform: rotateX(45deg) rotateZ(45deg);
    animation: ringSpin3 28s linear infinite;
  }

  .poly-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffffff 10%, #00f7ff 60%, transparent 100%);
    box-shadow: 0 0 25px #00f7ff, 0 0 50px #ff007f;
    animation: pulseGlow 4s ease-in-out infinite alternate;
  }

  @keyframes ringSpin1 {
    0% { transform: rotateX(65deg) rotateY(25deg) rotateZ(0deg); }
    100% { transform: rotateX(65deg) rotateY(25deg) rotateZ(360deg); }
  }

  @keyframes ringSpin2 {
    0% { transform: rotateX(25deg) rotateY(70deg) rotateZ(0deg); }
    100% { transform: rotateX(25deg) rotateY(70deg) rotateZ(360deg); }
  }

  @keyframes ringSpin3 {
    0% { transform: rotateX(45deg) rotateZ(45deg) rotateY(0deg); }
    100% { transform: rotateX(45deg) rotateZ(45deg) rotateY(360deg); }
  }

  @media (max-width: 900px) {
    .floating-cyber-poly {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-cyber-poly, .ring-1, .ring-2, .ring-3, .poly-core {
      animation: none !important;
    }
  }
</style>

<script>
  function initCosmicCanvas() {
    const canvas = document.getElementById('cosmic-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.innerWidth < 640) {
      canvas.style.display = 'none';
      return;
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    let resizeTimer: any;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }, 150);
    }, { passive: true });

    // Laser Shooting Stars
    interface ShootingStar {
      x: number;
      y: number;
      length: number;
      speed: number;
      angle: number;
      color: string;
      alpha: number;
      active: boolean;
    }

    const shootingStars: ShootingStar[] = [];
    const colors = ['#00f7ff', '#ff007f', '#00ff9d', '#ffffff'];
    let isAnimating = false;

    function spawnShootingStar() {
      if (document.hidden || shootingStars.length > 2) return;
      shootingStars.push({
        x: Math.random() * width * 0.7 + width * 0.1,
        y: Math.random() * height * 0.35,
        length: Math.random() * 100 + 70,
        speed: Math.random() * 8 + 10,
        angle: Math.PI / 4 + (Math.random() - 0.5) * 0.15,
        color: colors[Math.floor(Math.random() * colors.length)],
        alpha: 0.9,
        active: true,
      });

      if (!isAnimating) {
        isAnimating = true;
        requestAnimationFrame(render);
      }
    }

    // Run star spawn periodically
    let starTimer = setInterval(() => {
      if (Math.random() > 0.4) {
        spawnShootingStar();
      }
    }, 3200);

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      // Render and update shooting stars
      for (let i = shootingStars.length - 1; i >= 0; i--) {
        const star = shootingStars[i];
        if (!star.active) continue;

        const tailX = star.x - Math.cos(star.angle) * star.length;
        const tailY = star.y - Math.sin(star.angle) * star.length;

        const grad = ctx.createLinearGradient(star.x, star.y, tailX, tailY);
        grad.addColorStop(0, star.color);
        grad.addColorStop(1, 'transparent');

        ctx.beginPath();
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.8;
        ctx.globalAlpha = star.alpha;
        ctx.moveTo(star.x, star.y);
        ctx.lineTo(tailX, tailY);
        ctx.stroke();

        // Crisp white head dot without heavy shadowBlur
        ctx.beginPath();
        ctx.arc(star.x, star.y, 1.8, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();

        star.x += Math.cos(star.angle) * star.speed;
        star.y += Math.sin(star.angle) * star.speed;
        star.alpha -= 0.018;

        if (star.alpha <= 0 || star.x > width + 100 || star.y > height + 100) {
          shootingStars.splice(i, 1);
        }
      }

      ctx.globalAlpha = 1;

      if (shootingStars.length > 0) {
        requestAnimationFrame(render);
      } else {
        isAnimating = false;
        ctx.clearRect(0, 0, width, height);
      }
    }

    document.addEventListener('astro:before-swap', () => {
      clearInterval(starTimer);
      shootingStars.length = 0;
      isAnimating = false;
    });
  }

  initCosmicCanvas();
  document.addEventListener('astro:page-load', initCosmicCanvas);
</script>
