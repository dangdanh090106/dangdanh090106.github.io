---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags: string[];
  cover?: string;
  readingTime?: string;
}

const { title, description, pubDate, slug, tags, cover, readingTime } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate);
---

<article class="post-card glass-card">
  {cover && (
    <a href={`/posts/${slug}/`} class="post-thumb-link">
      <div class="post-thumb-wrap">
        <img src={cover} alt={title} loading="lazy" class="post-thumb-img" />
        <div class="thumb-overlay"></div>
      </div>
    </a>
  )}

  <div class="post-meta">
    <time datetime={pubDate.toISOString()} class="post-date">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      {formattedDate}
    </time>

    {readingTime && (
      <span class="reading-time">
        • {readingTime}
      </span>
    )}
  </div>

  <h3 class="post-title">
    <a href={`/posts/${slug}/`}>{title}</a>
  </h3>

  <p class="post-desc">{description}</p>

  <div class="post-footer">
    <div class="post-tags">
      {tags.map((tag) => (
        <span class="tag-pill">#{tag}</span>
      ))}
    </div>

    <a href={`/posts/${slug}/`} class="read-more-link" aria-label={`Đọc bài viết: ${title}`}>
      <span>Đọc bài</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-md);
  }

  .post-thumb-wrap {
    position: relative;
    width: 100%;
    height: 175px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #04060d;
    margin-bottom: var(--space-xs);
  }

  .post-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-spring);
  }

  .post-card:hover .post-thumb-img {
    transform: scale(1.05);
  }

  .thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(8, 12, 26, 0.7) 100%);
    pointer-events: none;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .post-date {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-cyan);
  }

  .post-title {
    font-size: 1.3rem;
    line-height: 1.35;
  }

  .post-title a {
    color: var(--text-primary);
    transition: all var(--duration-fast);
  }

  .post-card:hover .post-title a {
    color: var(--accent-cyan);
    text-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
  }

  .post-desc {
    font-size: 0.96rem;
    color: var(--text-secondary);
    line-height: 1.65;
    flex-grow: 1;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: #c084fc;
    background: rgba(168, 85, 247, 0.1);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent-cyan);
    transition: all var(--duration-fast);
  }

  .read-more-link:hover {
    color: #ffffff;
    transform: translateX(4px);
  }
</style>
