---
---

<div class="aurora-wrapper" aria-hidden="true">
  <!-- Overhead Cyber Beam / Luminous Apex -->
  <div class="overhead-beam"></div>

  <!-- Cosmic Plasma Blobs - GPU Texture Optimized -->
  <div class="nebula-blob cyan"></div>
  <div class="nebula-blob violet"></div>
  <div class="nebula-blob magenta"></div>
  <div class="nebula-blob blue"></div>

  <!-- Ambient Digital Vignette -->
  <div class="ambient-vignette"></div>
</div>

<style>
  .aurora-wrapper {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    transform: translateZ(0);
  }

  /* Luminous top spotlight beam */
  .overhead-beam {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%) translateZ(0);
    width: 800px;
    height: 400px;
    background: radial-gradient(ellipse 65% 50% at 50% 0%, rgba(0, 247, 255, 0.22) 0%, rgba(168, 85, 247, 0.1) 45%, transparent 75%);
    filter: blur(25px);
    opacity: 0.85;
    will-change: transform;
  }

  .nebula-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(35px);
    transform: translateZ(0);
    will-change: transform;
  }

  .nebula-blob.cyan {
    top: 5%;
    left: 10%;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(0, 247, 255, 0.25) 0%, rgba(0, 247, 255, 0.04) 50%, transparent 70%);
    animation: nebulaDrift1 22s ease-in-out infinite alternate;
  }

  .nebula-blob.violet {
    top: 25%;
    right: -5%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.22) 0%, rgba(168, 85, 247, 0.04) 50%, transparent 70%);
    animation: nebulaDrift2 26s ease-in-out infinite alternate;
  }

  .nebula-blob.magenta {
    top: 55%;
    left: 20%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(255, 0, 127, 0.18) 0%, rgba(255, 0, 127, 0.03) 50%, transparent 70%);
    animation: nebulaDrift3 24s ease-in-out infinite alternate;
  }

  .nebula-blob.blue {
    bottom: -15%;
    right: 15%;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.2) 0%, rgba(37, 99, 235, 0.03) 50%, transparent 70%);
    animation: nebulaDrift1 20s ease-in-out infinite alternate-reverse;
  }

  .ambient-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, transparent 50%, rgba(3, 5, 12, 0.7) 100%);
  }

  @keyframes nebulaDrift1 {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 60px); }
  }

  @keyframes nebulaDrift2 {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-60px, -50px); }
  }

  @keyframes nebulaDrift3 {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-40px, 50px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nebula-blob {
      animation: none !important;
      opacity: 0.15;
    }
  }
</style>
