---
import BaseLayout from '../layouts/BaseLayout.astro';

const timeline = [
  {
    year: '2026 - Nay',
    title: 'Nghiên cứu & Kỹ thuật Hệ thống Đa tác tử (Agentic AI Systems)',
    description: 'Tập trung xây dựng các quy trình tự động hóa lập trình, tích hợp LLM vào hệ thống phần mềm và thiết kế kiến trúc AI tương tác.',
    highlight: true,
  },
  {
    year: '2025 - 2026',
    title: 'Phát triển Web Tĩnh & Hệ thống Hiệu năng cao',
    description: 'Tối ưu hóa kiến trúc Jamstack/Islands, nghiên cứu các chuẩn mực web hiện đại với Astro, Next.js và TypeScript.',
    highlight: false,
  },
  {
    year: '2024 - 2025',
    title: 'Xây dựng Nền tảng Kỹ thuật Phần mềm & Thuật toán',
    description: 'Chuyên sâu về cấu trúc dữ liệu, thuật toán, lập trình hướng đối tượng, Python và các cơ sở dữ liệu quan hệ/phi quan hệ.',
    highlight: false,
  },
];

const principles = [
  {
    title: 'Đơn giản hóa Triệt để (Radical Simplicity)',
    desc: 'Giải pháp tốt nhất là giải pháp giải quyết trọn vẹn vấn đề với số lượng thành phần tối thiểu và độ phức tạp thấp nhất.',
  },
  {
    title: 'Ưu tiên Trải nghiệm & Tốc độ',
    desc: 'Tốc độ phản hồi và tính tiếp cận (accessibility) không phải là tính năng bổ sung, mà là nền tảng cốt lõi của sản phẩm số.',
  },
  {
    title: 'Tự động hóa & Khả năng Tái lập',
    desc: 'Mọi quy trình từ kiểm thử, build đến deploy đều phải được mã hóa thành code và tự động hóa qua pipeline CI/CD.',
  },
  {
    title: 'Liên tục Cập nhật Biên giới Công nghệ',
    desc: 'Trí tuệ Nhân tạo đang tái cấu trúc ngành phần mềm; người làm kỹ thuật phải liên tục cập nhật và thử nghiệm cái mới.',
  },
];
---

<BaseLayout title="About" description="Hồ sơ cá nhân, hành trình kỹ thuật, triết lý làm việc của Đặng Danh.">
  <div class="container about-container">
    <!-- Header Hero -->
    <section class="about-hero">
      <div class="hero-text">
        <span class="cyber-badge">HỒ SƠ CÁ NHÂN</span>
        <h1 class="page-title">Hành trình &amp; <span class="neon-gradient-text">Tầm nhìn Kỹ thuật</span></h1>
        <p class="hero-bio">
          Tôi là <strong class="name-bold">Đặng Danh</strong>, một kỹ sư phần mềm định hướng AI. Tôi đam mê xây dựng những sản phẩm kết hợp giữa sự chặt chẽ của kỹ thuật phần mềm truyền thống và sức mạnh của Trí tuệ Nhân tạo thế hệ mới.
        </p>

        <div class="about-actions">
          <a href="/files/resume.pdf" target="_blank" rel="noopener noreferrer" class="cyber-button primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>Tải CV / Sơ yếu lý lịch (PDF)</span>
          </a>

          <a href="/contact/" class="cyber-button secondary">
            <span>Liên hệ trao đổi</span>
          </a>
        </div>
      </div>

      <!-- Avatar / Cyber Profile Card -->
      <div class="profile-card-wrap">
        <div class="profile-card glass-card">
          <div class="avatar-holder">
            <img src="/images/avatar.svg" alt="Đặng Danh - Software Engineer &amp; AI Researcher" class="avatar-img" />
          </div>
          <div class="profile-info">
            <h3 class="profile-name">Đặng Danh</h3>
            <span class="profile-role">Software Engineer &amp; AI Researcher</span>
            <div class="profile-status">
              <span class="status-dot"></span>
              <span>Available for high-impact roles</span>
            </div>
          </div>
          <div class="profile-links">
            <a href="https://github.com/dangdanh090106" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
            </a>
            <a href="mailto:contact.dangdanh@example.com" class="icon-btn" aria-label="Email">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Work Philosophy -->
    <section class="about-section">
      <span class="cyber-badge violet">NGUYÊN TẮC</span>
      <h2 class="sub-title">Triết lý Kỹ thuật</h2>
      <div class="principles-grid">
        {principles.map((item) => (
          <div class="principle-card glass-card">
            <h3 class="principle-title">{item.title}</h3>
            <p class="principle-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Journey Timeline -->
    <section class="about-section">
      <span class="cyber-badge">CỘT MỐC PHÁT TRIỂN</span>
      <h2 class="sub-title">Lộ trình Tiến hóa</h2>
      <div class="timeline-wrapper">
        {timeline.map((item) => (
          <div class={`timeline-item ${item.highlight ? 'highlight' : ''}`}>
            <div class="timeline-marker">
              <span class="marker-dot"></span>
              <div class="marker-line"></div>
            </div>
            <div class="timeline-content glass-card">
              <span class="timeline-year">{item.year}</span>
              <h3 class="timeline-title">{item.title}</h3>
              <p class="timeline-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-container {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-4xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
  }

  .about-hero {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4.5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  .hero-bio {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 620px;
  }

  .name-bold {
    color: #ffffff;
  }

  .about-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding-top: var(--space-sm);
  }

  /* Profile Card */
  .profile-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
    padding: var(--space-2xl) var(--space-xl);
    background: linear-gradient(180deg, rgba(16, 24, 46, 0.88) 0%, rgba(10, 15, 30, 0.8) 100%);
    border: 1px solid rgba(0, 240, 255, 0.3);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 35px rgba(0, 240, 255, 0.2);
  }

  .avatar-holder {
    width: 125px;
    height: 125px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-magenta), var(--accent-violet));
    box-shadow: 0 0 30px rgba(0, 240, 255, 0.45);
    animation: borderRotate 6s linear infinite alternate;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: #04060d;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .profile-name {
    font-size: 1.4rem;
  }

  .profile-role {
    font-size: 0.92rem;
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .profile-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--accent-emerald);
    margin-top: 0.4rem;
    font-family: var(--font-mono);
  }

  .profile-links {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .icon-btn {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-secondary);
    transition: all var(--duration-fast);
  }

  .icon-btn:hover {
    color: #ffffff;
    border-color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.15);
    box-shadow: var(--glow-cyan-sm);
    transform: translateY(-2px);
  }

  /* About Sections */
  .about-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .sub-title {
    font-size: 2.1rem;
    margin-bottom: var(--space-md);
  }

  /* Principles Grid */
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl);
  }

  .principle-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: rgba(12, 18, 36, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.09);
    transition: all var(--duration-fast);
  }

  .principle-card:hover {
    border-color: rgba(0, 240, 255, 0.35);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 240, 255, 0.15);
  }

  .principle-title {
    font-size: 1.2rem;
    color: var(--accent-cyan);
  }

  .principle-desc {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Timeline */
  .timeline-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: relative;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: var(--space-xl);
    position: relative;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .marker-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 2px solid var(--accent-cyan);
    box-shadow: 0 0 15px var(--accent-cyan);
    z-index: 2;
  }

  .timeline-item.highlight .marker-dot {
    background: var(--accent-cyan);
    box-shadow: 0 0 20px var(--accent-cyan);
  }

  .marker-line {
    width: 2px;
    flex-grow: 1;
    background: rgba(255, 255, 255, 0.1);
    margin-top: 4px;
  }

  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: rgba(12, 18, 36, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.09);
  }

  .timeline-year {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--accent-magenta);
  }

  .timeline-title {
    font-size: 1.25rem;
    color: #ffffff;
  }

  .timeline-desc {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .about-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
