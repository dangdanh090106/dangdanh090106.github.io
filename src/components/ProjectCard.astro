---
interface Props {
  title: string;
  description: string;
  category: string;
  tags: string[];
  cover?: string;
  github?: string;
  demo?: string;
  status?: 'Completed' | 'In Development' | 'Experimental';
  featured?: boolean;
}

const {
  title,
  description,
  category,
  tags,
  cover,
  github,
  demo,
  status = 'Completed',
  featured = false,
} = Astro.props;

const statusColorMap = {
  Completed: 'status-live',
  'In Development': 'violet',
  Experimental: 'magenta',
};
---

<article class={`project-card glass-card ${featured ? 'featured laser-border-beam' : ''}`}>
  {cover && (
    <div class="card-thumb-wrap">
      <img src={cover} alt={title} loading="lazy" class="card-thumb-img" />
      <div class="thumb-overlay"></div>
      <div class="thumb-scanline" aria-hidden="true"></div>
      <div class="thumb-bracket tl" aria-hidden="true"></div>
      <div class="thumb-bracket tr" aria-hidden="true"></div>
      <div class="thumb-bracket bl" aria-hidden="true"></div>
      <div class="thumb-bracket br" aria-hidden="true"></div>
    </div>
  )}

  <div class="card-meta">
    <span class="category-tag">{category}</span>
    <span class={`cyber-badge ${statusColorMap[status] || ''}`}>
      {status === 'Completed' && <span class="status-dot"></span>}
      {status}
    </span>
  </div>

  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>

  <div class="card-tags">
    {tags.map((tag) => (
      <span class="tech-tag">#{tag}</span>
    ))}
  </div>

  <div class="card-footer">
    {demo && (
      <a href={demo} target="_blank" rel="noopener noreferrer" class="action-btn demo-btn">
        <span>Live Demo</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    )}

    {github && (
      <a href={github} target="_blank" rel="noopener noreferrer" class="action-btn code-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        <span>Mã nguồn</span>
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-md);
  }

  .project-card.featured {
    border-color: rgba(0, 240, 255, 0.35);
    background: linear-gradient(180deg, rgba(16, 26, 50, 0.8) 0%, rgba(10, 16, 32, 0.75) 100%);
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.8), 0 0 25px rgba(0, 240, 255, 0.2);
  }

  /* Thumbnail Wrap */
  .card-thumb-wrap {
    position: relative;
    width: 100%;
    height: 175px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #04060d;
    margin-bottom: var(--space-xs);
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-spring);
  }

  .project-card:hover .card-thumb-img {
    transform: scale(1.05);
  }

  .thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(8, 12, 26, 0.7) 100%);
    pointer-events: none;
  }

  /* Holographic Scanline & Targeting Brackets */
  .thumb-scanline {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #38bdf8, #f43f5e, transparent);
    box-shadow: 0 0 10px #38bdf8;
    opacity: 0;
    pointer-events: none;
    z-index: 2;
  }

  .project-card:hover .thumb-scanline {
    opacity: 0.85;
    animation: hudScan 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .thumb-bracket {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: var(--accent-cyan);
    opacity: 0;
    transition: all 0.3s var(--ease-spring);
    pointer-events: none;
    z-index: 2;
  }

  .thumb-bracket.tl { top: 6px; left: 6px; border-top: 2px solid; border-left: 2px solid; transform: translate3d(-3px, -3px, 0); }
  .thumb-bracket.tr { top: 6px; right: 6px; border-top: 2px solid; border-right: 2px solid; transform: translate3d(3px, -3px, 0); }
  .thumb-bracket.bl { bottom: 6px; left: 6px; border-bottom: 2px solid; border-left: 2px solid; transform: translate3d(-3px, 3px, 0); }
  .thumb-bracket.br { bottom: 6px; right: 6px; border-bottom: 2px solid; border-right: 2px solid; transform: translate3d(3px, 3px, 0); }

  .project-card:hover .thumb-bracket {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .category-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .card-title {
    font-size: 1.35rem;
    color: var(--text-primary);
    transition: all var(--duration-fast);
  }

  .project-card:hover .card-title {
    color: var(--accent-cyan);
    text-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
  }

  .card-desc {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.65;
    flex-grow: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all var(--duration-fast);
  }

  .project-card:hover .tech-tag {
    border-color: rgba(0, 240, 255, 0.25);
    color: #cbd5e1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--duration-fast);
  }

  .demo-btn {
    color: #040812;
    background: linear-gradient(135deg, #00f7ff, #3b82f6);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
  }

  .demo-btn:hover {
    box-shadow: 0 0 25px rgba(0, 240, 255, 0.7);
    transform: translateY(-2px);
    color: #020617;
  }

  .code-btn {
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .code-btn:hover {
    color: #ffffff;
    border-color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.1);
    transform: translateY(-2px);
  }
</style>
