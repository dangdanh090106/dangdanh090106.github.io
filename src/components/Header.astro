---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { name: 'Trang chủ', href: '/' },
  { name: 'Giới thiệu', href: '/about/' },
  { name: 'Dự án', href: '/projects/' },
  { name: 'Bài viết', href: '/posts/' },
  { name: 'Thử nghiệm AI', href: '/lab/' },
  { name: 'Liên hệ', href: '/contact/' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <div class="header-laser-line"></div>
  <div class="container header-container">
    <a href="/" class="brand-logo" aria-label="Đặng Danh Homepage">
      <div class="logo-symbol">
        <span class="symbol-bracket">&lt;</span>
        <span class="symbol-core">D</span>
        <span class="symbol-bracket">/&gt;</span>
      </div>
      <span class="brand-text">DANH<span class="brand-highlight">.DEV</span></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {isActive(item.href) && <span class="active-glow-pill"></span>}
              <span class="nav-text">{item.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a
        href="https://github.com/dangdanh090106"
        target="_blank"
        rel="noopener noreferrer"
        class="github-icon-link"
        aria-label="GitHub Profile"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </svg>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="menu-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-nav-menu" class="mobile-nav" hidden>
    <ul class="mobile-nav-links">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class={`mobile-nav-link ${isActive(item.href) ? 'active' : ''}`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.name}
          </a>
        </li>
      ))}
      <li class="mobile-divider"></li>
      <li>
        <a
          href="https://github.com/dangdanh090106"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-link external"
        >
          GitHub Profile ↗
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(4, 6, 13, 0.78);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-laser-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1.5px;
    background: linear-gradient(90deg, transparent 0%, rgba(0, 240, 255, 0.7) 30%, rgba(168, 85, 247, 0.7) 70%, transparent 100%);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.6);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 74px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 800;
  }

  .logo-symbol {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.1);
    border: 1px solid rgba(0, 240, 255, 0.4);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.55rem;
    box-shadow: 0 0 18px rgba(0, 240, 255, 0.3);
  }

  .symbol-core {
    color: #ffffff;
    margin: 0 0.15rem;
    font-weight: 900;
  }

  .brand-text {
    font-size: 1.2rem;
    letter-spacing: 0.06em;
  }

  .brand-highlight {
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-magenta));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 900;
  }

  .desktop-nav .nav-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    background: rgba(10, 16, 32, 0.6);
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-secondary);
    border-radius: var(--radius-full);
    transition: all var(--duration-fast);
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-link.active {
    color: #ffffff;
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.2) 0%, rgba(168, 85, 247, 0.18) 100%);
    border: 1px solid rgba(0, 240, 255, 0.4);
    box-shadow: 0 0 18px rgba(0, 240, 255, 0.25);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .github-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    transition: all var(--duration-fast);
  }

  .github-icon-link:hover {
    color: #ffffff;
    border-color: var(--accent-cyan);
    box-shadow: var(--glow-cyan-sm);
    transform: translateY(-2px);
  }

  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    cursor: pointer;
    padding: 9px;
  }

  .hamburger-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
  }

  .mobile-nav {
    display: none;
    border-top: 1px solid var(--border-subtle);
    background: rgba(8, 12, 24, 0.95);
    backdrop-filter: blur(20px);
    padding: var(--space-md) var(--space-xl);
  }

  .mobile-nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.8rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
    border-radius: var(--radius-md);
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    color: #ffffff;
    background: rgba(0, 240, 255, 0.15);
    border-left: 3px solid var(--accent-cyan);
  }

  .mobile-divider {
    height: 1px;
    background: var(--border-subtle);
    margin: 0.5rem 0;
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }
    .menu-btn {
      display: flex;
    }
    .mobile-nav:not([hidden]) {
      display: block;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-nav-menu');
    if (!toggleBtn || !mobileMenu) return;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        mobileMenu.setAttribute('hidden', '');
      } else {
        mobileMenu.removeAttribute('hidden');
      }
    });

    document.addEventListener('click', (e) => {
      if (!toggleBtn.contains(e.target as Node) && !mobileMenu.contains(e.target as Node)) {
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('hidden', '');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.hasAttribute('hidden')) {
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('hidden', '');
        toggleBtn.focus();
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
