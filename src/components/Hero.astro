---
import AnimatedGrid from './effects/AnimatedGrid.astro';
import ParticleField from './effects/ParticleField.astro';
---

<section class="hero-section">
  <!-- Dynamic 3D Horizon & Starfield Background -->
  <AnimatedGrid />
  <ParticleField />

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Friendly Status Capsule -->
      <div class="hero-capsule-wrapper">
        <div class="hero-capsule">
          <span class="capsule-pulse"></span>
          <span class="capsule-text">KỸ SƯ PHẦN MỀM &amp; PHÁT TRIỂN AI</span>
          <span class="capsule-arrow">✦</span>
        </div>
      </div>

      <!-- Main Welcoming Headline -->
      <h1 class="hero-title">
        Xây dựng sản phẩm số &amp; <br />
        <span class="neon-gradient-text glowing-text">Giải pháp AI thông minh</span>
      </h1>

      <div class="hero-identity">
        <span class="identity-greeting">Xin chào, tôi là</span>
        <span class="identity-name">Đặng Danh</span>
        <span class="identity-divider">/</span>
        <span class="identity-badge">Software Engineer</span>
      </div>

      <p class="hero-tagline">
        Chào mừng bạn đến với không gian cá nhân của tôi. Nơi tôi tập trung xây dựng các ứng dụng web hiệu năng cao, tích hợp Trí tuệ Nhân tạo thực tế và kiến tạo trải nghiệm người dùng trực quan, mượt mà.
      </p>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href="/projects/" class="cyber-button primary glowing-btn">
          <span>Khám phá Dự án</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="/posts/" class="cyber-button secondary">
          <span>Đọc Bài viết</span>
        </a>

        <a href="/contact/" class="cyber-button ghost">
          <span>Liên hệ với tôi</span>
        </a>
      </div>

      <!-- Quick Signals -->
      <div class="hero-signals">
        <div class="signal-item">
          <span class="signal-value gradient-val">100%</span>
          <span class="signal-label">Static &amp; Mượt mà</span>
        </div>
        <div class="signal-sep"></div>
        <div class="signal-item">
          <span class="signal-value cyan-val">Astro 5</span>
          <span class="signal-label">Kiến trúc Tối ưu</span>
        </div>
        <div class="signal-sep"></div>
        <div class="signal-item">
          <span class="signal-value magenta-val">Git-Ops</span>
          <span class="signal-label">Triển khai Tự động</span>
        </div>
      </div>
    </div>

    <!-- Personal Profile Showcase Card -->
    <div class="hero-visual">
      <div class="profile-hero-card glass-card">
        <!-- Ambient internal glow core -->
        <div class="card-ambient-glow"></div>

        <div class="card-header">
          <div class="card-status-indicator">
            <span class="status-dot"></span>
            <span class="card-status-text">SẴN SÀNG CHO DỰ ÁN MỚI</span>
          </div>
          <span class="card-location">📍 Việt Nam • UTC+7</span>
        </div>

        <div class="card-profile-section">
          <div class="avatar-container">
            <div class="avatar-ring-glow"></div>
            <img
              src="/images/avatar.svg"
              alt="Chân dung Đặng Danh"
              class="profile-avatar-img"
              width="130"
              height="130"
              loading="eager"
            />
          </div>

          <div class="profile-details">
            <h2 class="profile-title">Đặng Danh</h2>
            <p class="profile-subtitle">Software Engineer &amp; AI Builder</p>
            <p class="profile-bio">
              Đam mê kết hợp vẻ đẹp của thiết kế tương tác với sức mạnh tính toán của các mô hình AI tự hành.
            </p>
          </div>
        </div>

        <!-- Skill Tags -->
        <div class="profile-skills-row">
          <span class="skill-tag"><span class="tag-dot cyan"></span>Agentic AI</span>
          <span class="skill-tag"><span class="tag-dot magenta"></span>TypeScript</span>
          <span class="skill-tag"><span class="tag-dot violet"></span>Astro 5</span>
          <span class="skill-tag"><span class="tag-dot emerald"></span>Python &amp; PyTorch</span>
          <span class="skill-tag"><span class="tag-dot cyan"></span>CI/CD</span>
        </div>

        <!-- Footer Actions -->
        <div class="card-footer">
          <div class="social-links">
            <a href="https://github.com/dangdanh090106" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="GitHub Profile">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
              <span>GitHub</span>
            </a>

            <a href="https://linkedin.com/in/[YOUR_LINKEDIN]" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="LinkedIn Profile">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                <rect x="2" y="9" width="4" height="12" />
                <circle cx="4" cy="4" r="2" />
              </svg>
              <span>LinkedIn</span>
            </a>

            <a href="/files/resume.pdf" target="_blank" rel="noopener noreferrer" class="social-icon-btn resume-btn" aria-label="Tải CV">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="12" y1="18" x2="12" y2="12"></line>
                <line x1="9" y1="15" x2="15" y2="15"></line>
              </svg>
              <span>CV / Résumé</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 86vh;
    display: flex;
    align-items: center;
    padding: var(--space-4xl) 0 var(--space-3xl);
    overflow: hidden;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* Status Capsule */
  .hero-capsule-wrapper {
    display: flex;
  }

  .hero-capsule {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1.1rem;
    background: rgba(12, 18, 36, 0.7);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: var(--radius-full);
    backdrop-filter: blur(12px);
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.15);
    transition: all var(--duration-fast);
  }

  .hero-capsule:hover {
    border-color: var(--accent-cyan);
    box-shadow: var(--glow-cyan);
    transform: translateY(-2px);
  }

  .capsule-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: badgeBlink 1.8s infinite;
  }

  .capsule-text {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    background: linear-gradient(90deg, #ffffff, var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .capsule-arrow {
    color: var(--accent-cyan);
    font-weight: bold;
    font-size: 0.85rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  .glowing-text {
    filter: drop-shadow(0 0 30px rgba(56, 189, 248, 0.35));
  }

  .hero-identity {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    color: #e2e8f0;
    flex-wrap: wrap;
  }

  .identity-greeting {
    color: var(--text-muted);
  }

  .identity-name {
    color: #ffffff;
    font-weight: 700;
    font-size: 1.15rem;
  }

  .identity-divider {
    color: var(--accent-magenta);
    font-weight: bold;
  }

  .identity-badge {
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .hero-tagline {
    font-size: 1.08rem;
    color: var(--text-secondary);
    max-width: 580px;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding-top: var(--space-xs);
  }

  /* Signals */
  .hero-signals {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .signal-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .signal-value {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .gradient-val {
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-indigo));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .cyan-val { color: var(--accent-cyan); }
  .magenta-val { color: var(--accent-magenta); }

  .signal-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .signal-sep {
    width: 1px;
    height: 36px;
    background: rgba(255, 255, 255, 0.09);
  }

  /* Profile Card Showcase Visual */
  .profile-hero-card {
    position: relative;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.85) 0%, rgba(8, 12, 24, 0.85) 100%);
    border: 1px solid rgba(56, 189, 248, 0.28);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 35px rgba(56, 189, 248, 0.12);
    padding: var(--space-xl);
    border-radius: var(--radius-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    transition: transform var(--duration-normal), box-shadow var(--duration-normal);
  }

  .profile-hero-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 65px rgba(0, 0, 0, 0.7), 0 0 45px rgba(56, 189, 248, 0.2);
    border-color: rgba(56, 189, 248, 0.45);
  }

  .card-ambient-glow {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.18) 0%, rgba(129, 140, 248, 0.1) 50%, transparent 75%);
    filter: blur(50px);
    pointer-events: none;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-md);
  }

  .card-status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-status-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-emerald);
    letter-spacing: 0.05em;
  }

  .card-location {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Profile Details */
  .card-profile-section {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .avatar-container {
    position: relative;
    flex-shrink: 0;
  }

  .avatar-ring-glow {
    position: absolute;
    inset: -4px;
    border-radius: 28px;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-indigo), var(--accent-magenta));
    opacity: 0.6;
    filter: blur(6px);
    transition: opacity var(--duration-fast);
  }

  .profile-hero-card:hover .avatar-ring-glow {
    opacity: 0.9;
  }

  .profile-avatar-img {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 24px;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.2);
    display: block;
    background: #0c1328;
  }

  .profile-details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .profile-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .profile-subtitle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .profile-bio {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-top: 0.2rem;
  }

  /* Skills Row */
  .profile-skills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-secondary);
    transition: all var(--duration-fast);
  }

  .skill-tag:hover {
    color: var(--text-primary);
    background: rgba(56, 189, 248, 0.1);
    border-color: rgba(56, 189, 248, 0.3);
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .tag-dot.cyan { background: var(--accent-cyan); box-shadow: 0 0 6px var(--accent-cyan); }
  .tag-dot.magenta { background: var(--accent-magenta); box-shadow: 0 0 6px var(--accent-magenta); }
  .tag-dot.violet { background: var(--accent-violet); box-shadow: 0 0 6px var(--accent-violet); }
  .tag-dot.emerald { background: var(--accent-emerald); box-shadow: 0 0 6px var(--accent-emerald); }

  /* Footer Actions */
  .card-footer {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-md);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .social-icon-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    transition: all var(--duration-fast);
  }

  .social-icon-btn:hover {
    color: var(--text-primary);
    background: rgba(56, 189, 248, 0.12);
    border-color: var(--accent-cyan);
    transform: translateY(-1px);
  }

  .resume-btn {
    margin-left: auto;
    color: var(--accent-cyan);
    border-color: rgba(56, 189, 248, 0.3);
  }

  .resume-btn:hover {
    background: var(--accent-cyan);
    color: #04060d;
  }

  @media (max-width: 960px) {
    .hero-container {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .card-profile-section {
      flex-direction: column;
      text-align: center;
    }
    .hero-signals {
      gap: var(--space-md);
      flex-wrap: wrap;
    }
    .signal-sep {
      display: none;
    }
    .resume-btn {
      margin-left: 0;
      width: 100%;
      justify-content: center;
    }
    .social-links {
      width: 100%;
    }
  }
</style>
